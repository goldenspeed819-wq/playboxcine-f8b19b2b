{
  "manifest_version": 3,
  "name": "Rynex Helper",
  "version": "1.0.5",
  "description": "Ajuda o Rynex Cine a capturar embeds e enviar comandos reais de mouse/volume para players externos.",
  "permissions": ["storage", "tabs", "scripting", "webRequest", "debugger"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}